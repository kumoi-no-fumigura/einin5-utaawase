   ],
   "text": "新名所繪歌合音繁く聞らんよりも小車のやるかたなきは猶ふかゝらし權禰宜荒木田神主延行法眼能圓權禰宜荒木田神主長興大法師良玄大法師圓親大法師良譽大法師良惠講師讀師判者右三十番歌合以犬山候取〔所〓)藏後伏見院震輸〓",
   "poems": [
    "88"
   ],
   "lb": []
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "暮かたき春日をなかみつく〓〓とよもの山邊の霞をそみる",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "秋の日の影も淋しきよの色に日くらし鳴てくるゝ山本",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "くれかたき春の霞も秋の日のひさしき色も情をそみる.",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "こゝろ社あくかれはつれ夜もすから花の陰もる月に詠て",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "さもあらぬうれへもおほく色そひぬ月みる秋の物かなしさに",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "花の影にあくかれまさる心より秋なる月も一つにやみむ",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "影うすき月は軒はにみえそめて花のかさそふ春の夕かせ",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "ときは秋と心はかゝる山かけのあらしを松に聞そわひぬる",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "かけ薄き軒はの月も情あれと猶山かけの松の秋風",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "あし引の山邊の櫻咲ぬらし霞のそこにゝほふしら雲",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "うきて渡る夕の秋のむら雲につはさをかはす天津かり金",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "足引の山の櫻もむらくもにつはさもまかふ天つかりかね",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "何となくねられぬよはに聞ふけぬ長閑にすめる春雨の音",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "吹さはく荻の上葉のかせませにまはらにおつる秋のむら雨",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "のとか成春のよゝりも風ませにまはらにきかむ秋の村雨",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "立かくす遠の霞の一むらにけふりあまらぬ里の朝あけ",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "なにはかた月くもるよの霧よりもおなし烟も里の一むら",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "みえわかすそれかあらぬか歸る雁明行かねに聲もまかひて",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "軒ちかき荻のうははに音つれて風はた寒き明かたの月",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "かれの聲風はた寒き月影もおなし程なる明方の空",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "夜の雨の名殘露けき花の色の常より增るけさのあさ明",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "色々に千草このはそみたれける野分あれける庭の朝あけ",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "夜の雨の名殘の花も色々のちくさの庭もめかれやはする",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "飛鳥のつばさのとかに見わたせは夕暮ふかくかすむ山端",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "吹したふ夕かせ寒きうき雲に鳴てそわたる雁の一つら",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "のとが成鳥のつはさは見ふりしを夕の雲も立やまかはむ",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "あけはみむ花に心はいそかれてみしかき夜はも久しとそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "きり〓〓すやゝ鳴そめて月の色のまたき身にしむ初秋の空",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "花故に明るを急き月の色の身にしむよはもわきそかねぬる",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "雨はるゝ外山のみねの雲間より聲ほのか成ほとゝきすかな",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "み山邊やとひくる人の跡もなしいく日の雪にみちやとちぬる",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "跡もなきいくかの雪のみちよりも山時鳥猶やまたまし",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "月〓みなつも忘れてあかす哉川せすゝしき波のよる〓〓",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "ふゆ寒み氷にけらし谷川の岩間にむせふ音も聞えす",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "月きよみ凉しきよはも冬寒み氷るもおなしせゝの川波",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "のへ遠き草のしけみに露見えて秋をむかへぬ暮もすゝしき",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "かれわたるのはらはおなし色にして薄雪さむし淺ちふの上",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "野へ遠き露の夕もうす雪のかれの〓はらも心ありけり",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "なつの日にすゝみすらしも旅人のあまた立よる岡の松かけ",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "をかのへや松はの雪はうすけれと見やれはしろき遠近の山",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "をちこちの薄雪よりも旅人のあまた立よるをかの松かけ",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "夕立のはれ行雲の追風にまた雨おつるもりの下かけ",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "霜雪もはらはぬまゝに打はへてかはく時なきもりの下露",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "しも雪の露よりも猶追風にまた雨おつるもりの下かけ",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "すまのうらや磯邊の松もしほれつゝ波よせまさる五月雨の頃",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "吹さゆる音のみ冬のうち風に時雨も雪もみえぬ波かな",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "五月雨に波寄まさる浦よりも音のみ冬のかせやきかまし",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "夏そしらぬみなそこ澄みて月影のみかく玉江の波のよる〓〓",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "月みかく玉江の波に心よせてかれはの蘆はみる人やなき",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "山里の松の木かけの夕すゝみ夏はかくても暮しぬへきを",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "昨日けふ外山の雪け風あれて寒く時雨るゝしからきの里",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "風あるゝ外山の雪けしくるらむ景色そ〓とに見る心ちする",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "しけりあふ汀の木立ものふりてみとり涼しき庭の池水",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "へたてゝも猶戀しきは九重のいけのみきはの雪のおもかけ",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "とり〓〓におも影浮ふ池水に木たちふりぬる影や涼しき",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "いけ水のにこらぬ色を猶そめて庭なる木々もしける頃かな",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "夕かせにかれたつ薄うちなひき霰ふりすさふ庭の淋しさ",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "池水をみとりにそむる木々よりもすゝきなひきて霰降庭",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "つらくなる入相の聲も哀也聞て嬉しき時もありしを",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "大かたの夕にこもる世の色の哀にゝほふいりあひのかね",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "きゝかへむ哀はあれと大かたの夕にこもる入あひのかね",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "たきつせの岩に玉なす波よりも我心社なをくたくらめ",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "もくつにも光やそはん和歌の浦やかひ有けふの玉にましりて",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "瀧津せに碎けんよりもわかの浦の玉の光そ猶まさるらん",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "あはぬよをかさねてしほる衣手はひる時もなしほす人もなし",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "諸人の衣の色にしられけりとき折ふしのかはるすかたは",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "折節にかはる姿もあはぬよを重ぬる袖もいつれともなし",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "いかにねて夢をもまたん馴しよのおもかけ遠き床の枕に",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "苔の上草の枕にあかすよを風そ音つれ月そともなふ",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "ねられぬに待らん夢も苔の上にともなふ月もみな哀也",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "打ちふして今宵やもしとさむしろに淋しく明すよはそ積れる",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "これも又ゆへ社あらめよな〓〓に我ふしなるゝ床の小莚",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "打ちふすと猶さりけなる〓とはよりなるゝを思ふ床のさ莚",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "朝夕にみなれし物をますかゝみ誰に心をうつしはつらむ",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "みす知らぬ昔をうつせますかゝみ變りのみ行よのゆかしきに",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "見なれしも昔忍ふもますかゝみうつす心はひとつ成らむ",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "明ぬるか又こよひもと思ふより泪にうかふともし火のかけ",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "かすかなる鐘のひゝきもきこゆ也ひとりよふくる燈火の本",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "思ひやる哀もふかくうかふらん泪のうちのともし火の影",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "玉札をみるしもうかふ淚かな有しにもにぬ人の〓とのは",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "あとはかりけにもちとせのかたみ哉ぬ-は昔になれる玉つさ",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "ありてよにかはらむよりも哀也昔の跡としのふ玉づさ",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "浦かくれ入江にすつるわれふねのわれそくたけて人は戀しき",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "身をうみの海士の小ふねのいつとなく哀うきても世を渡る哉",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "江に棄つるわれたる船も身を海にうきて渡るも哀とそみる",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "戀しさのやるかたそなき小車のうしつらしとは思ひとれとも",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "をくるまの行かふ音のしけき哉たか何ゆへにいそく成らん",
   "kana": "",
   "speaker": "",
   "page": 337,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "音繁く聞らんよりも小車のやるかたなきは猶ふかゝらし",
   "kana": "",
   "speaker": "",
   "page": 338,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
 "catalog": {
